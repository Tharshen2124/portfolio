---
import Layout from '../layouts/Layout.astro';
import EntryList from '../components/EntryList.astro';
import { site } from '../data/site';
import { getSubstackFeed } from '../lib/substack';
import { formatDay } from '../lib/format';
import { absoluteUrl, breadcrumbSchema, graph, personId, personSchema } from '../lib/seo';

const { description, posts } = await getSubstackFeed();
const blurb = (description ?? 'Writing about Site Reliability, Observability and DevOps').replace(/\.?$/, '.');
const entries = posts.map((post) => ({
	date: formatDay(post.date),
	title: post.title,
	href: post.url,
}));

const title = 'Blog: Site Reliability, Observability & DevOps';
const pageDescription =
	"Tharshen's writing on Site Reliability Engineering, Observability and DevOps, published on Substack.";
const jsonLd = graph(
	{
		'@type': 'Blog',
		url: absoluteUrl('/blog'),
		name: title,
		description: pageDescription,
		author: { '@id': personId },
		blogPost: posts.map((post) => ({
			'@type': 'BlogPosting',
			headline: post.title,
			url: post.url,
			datePublished: post.date.toISOString(),
			author: { '@id': personId },
		})),
	},
	personSchema(),
	breadcrumbSchema([
		{ name: 'Home', path: '/' },
		{ name: 'Blog', path: '/blog' },
	]),
);
---

<Layout title={title} description={pageDescription} jsonLd={jsonLd}>
	<h1 class="page-title">My Blog</h1>
	<p class="lede">
		{blurb} Posts live on <a href={site.substackUrl} target="_blank" rel="noopener noreferrer"
			>Substack</a
		>.
	</p>

	{
		entries.length > 0 ? (
			<EntryList entries={entries} />
		) : (
			<a class="more-link" href={site.substackUrl} target="_blank" rel="noopener noreferrer">
				Read on Substack ↗
			</a>
		)
	}

	<h2 class="section-title">Subscribe</h2>
	<iframe
		class="substack-embed"
		src={`${site.substackUrl}/embed`}
		title="Subscribe to Tharshen on Substack"
		loading="lazy"
		scrolling="no"></iframe>
</Layout>

<style>
	.substack-embed {
		display: block;
		width: 100%;
		max-width: 30rem;
		height: 320px;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: #fff;
	}
</style>
