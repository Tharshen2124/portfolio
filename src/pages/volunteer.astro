---
import Layout from '../layouts/Layout.astro';
import Back from '../components/game/Back.astro';
import Emblem from '../components/game/Emblem.astro';
import Ornament from '../components/game/Ornament.astro';
import ScreenTitle from '../components/game/ScreenTitle.astro';
import Tabs from '../components/game/Tabs.astro';
import type { EmblemName } from '../lib/emblems';
import { categorySchema, experienceHref, getExperience } from '../lib/experience';
import { formatRange } from '../lib/format';

const volunteer = (await getExperience()).filter((entry) => entry.data.category === 'volunteer');

/** Each role's badge, read from what the role was. */
const emblemFor = (role: string): EmblemName => {
	if (/mentor/i.test(role)) return 'lantern';
	if (/president|director/i.test(role)) return 'crown';
	if (/secretary/i.test(role)) return 'quill';
	if (/multimedia/i.test(role)) return 'camera';
	if (/technical|developer/i.test(role)) return 'cog';
	return 'pennant';
};

const feats = volunteer.map((entry) => {
	const { role, organization, startDate, endDate, summary } = entry.data;
	return {
		href: experienceHref(entry),
		role,
		organization,
		when: formatRange(startDate, endDate),
		summary,
		emblem: emblemFor(role),
	};
});

const description =
	"Tharshen's volunteering: leading IT Society and Hackerspace MMU as President, directing BarCamp Cyberjaya, mentoring, and the roles before them.";
---

<Layout
	title="Volunteer Experience"
	description={description}
	jsonLd={categorySchema('volunteer', volunteer, description)}
	back="/"
	withEmblems
>
	<div class="screen">
		<Tabs current="/volunteer" />
		<main id="main" class="volunteer">
			<ScreenTitle>Volunteer Experience</ScreenTitle>

			<ol class="feats" data-menu data-keys data-enter style="--delay: 350">
				{
					feats.map((feat) => (
						<li class:list={['feat', { locked: !feat.href }]} data-item={feat.href ? '' : undefined}>
							<span class="badge">
								<Emblem name={feat.emblem} />
								<Ornament name="bracket" class="badge-corner" />
								<Ornament name="bracket" class="badge-corner" />
								<Ornament name="bracket" class="badge-corner" />
								<Ornament name="bracket" class="badge-corner" />
							</span>
							<div class="feat-text">
								<h2 class="feat-title">
									{feat.href ? (
										<a class="feat-link" href={feat.href}>
											{feat.role}
											<span class="visually-hidden"> at {feat.organization}</span>
										</a>
									) : (
										<>
											{feat.role}
											<span class="visually-hidden"> at {feat.organization}</span>
										</>
									)}
								</h2>
								<p class="feat-org">
									{feat.organization}
									<span class="feat-when">
										<span class="feat-sep" aria-hidden="true">
											·
										</span>
										{feat.when}
									</span>
								</p>
								<p class="feat-summary">{feat.summary}</p>
							</div>
						</li>
					))
				}
			</ol>

			<Back href="/" to="the title menu" />
		</main>

		<div class="rail" aria-hidden="true">
			<div class="rail-thumb"><Ornament name="finial" /></div>
		</div>
	</div>
</Layout>

<script>
	// The rail's finial follows how far down the list you've read. Screens are
	// swapped in by the ClientRouter, so it's set up on each page load that has
	// a rail and let go before the next screen arrives.
	let release = () => {};
	document.addEventListener('astro:before-swap', () => release());
	document.addEventListener('astro:page-load', () => {
		release();
		const rail = document.querySelector<HTMLElement>('.rail');
		if (!rail) return;
		const listening = new AbortController();
		let queued = false;
		const update = () => {
			queued = false;
			const room = document.documentElement.scrollHeight - window.innerHeight;
			rail.style.setProperty('--progress', String(room > 0 ? Math.min(1, window.scrollY / room) : 0));
		};
		const queue = () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(update);
			}
		};
		update();
		window.addEventListener('scroll', queue, { passive: true, signal: listening.signal });
		window.addEventListener('resize', queue, { signal: listening.signal });
		release = () => listening.abort();
	});
</script>

<style>
	.volunteer {
		padding-top: clamp(0.5rem, 3vh, 2rem);
	}

	.feats {
		display: grid;
		gap: clamp(1.1rem, 2.6vh, 1.6rem);
		width: min(100% - 2 * var(--gutter), 48rem);
		margin: clamp(2rem, 6vh, 3.25rem) auto 0;
		padding: 0;
		list-style: none;
	}

	.feat {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(1rem, 2.5vw, 1.6rem);
		align-items: start;
	}

	/* The badge: an emblem in a framed square, lit when its row is chosen. */
	.badge {
		position: relative;
		display: grid;
		place-items: center;
		width: clamp(3.6rem, 3rem + 2vw, 4.5rem);
		aspect-ratio: 1;
		margin-top: 0.2rem;
		border: 1px solid rgba(243, 240, 232, 0.4);
		background: radial-gradient(circle at 50% 40%, rgba(64, 74, 100, 0.55), rgba(8, 10, 15, 0.92) 75%);
		box-shadow:
			inset 0 0 14px rgba(0, 0, 0, 0.85),
			0 0 0 4px rgba(3, 4, 6, 0.6);
		transition:
			border-color 0.3s,
			box-shadow 0.3s;
	}

	.badge > :global(.emblem) {
		width: 68%;
		color: var(--soft);
		transition:
			color 0.3s,
			filter 0.3s;
	}

	.badge > :global(.badge-corner) {
		position: absolute;
		width: 32%;
		height: auto;
		color: var(--pale);
		opacity: 0.55;
		transition: opacity 0.3s;
	}

	.badge > :global(.badge-corner:nth-of-type(2)) {
		top: -14%;
		left: -14%;
	}

	.badge > :global(.badge-corner:nth-of-type(3)) {
		top: -14%;
		right: -14%;
		transform: scaleX(-1);
	}

	.badge > :global(.badge-corner:nth-of-type(4)) {
		bottom: -14%;
		left: -14%;
		transform: scaleY(-1);
	}

	.badge > :global(.badge-corner:nth-of-type(5)) {
		bottom: -14%;
		right: -14%;
		transform: scale(-1);
	}

	.feat[data-selected] .badge {
		border-color: rgba(255, 255, 255, 0.95);
		box-shadow:
			inset 0 0 16px rgba(174, 191, 255, 0.35),
			0 0 18px rgba(255, 255, 255, 0.28),
			0 0 0 4px rgba(3, 4, 6, 0.6);
	}

	.feat[data-selected] .badge > :global(.emblem) {
		color: #fff;
		filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.7));
	}

	.feat[data-selected] .badge > :global(.badge-corner) {
		opacity: 1;
	}

	/* Roles with no write-up stay unlit, like an achievement not yet earned. */
	.locked .badge {
		border-color: rgba(243, 240, 232, 0.18);
		background: radial-gradient(circle at 50% 40%, rgba(40, 45, 58, 0.5), rgba(8, 10, 15, 0.92) 75%);
	}

	.locked .badge > :global(.emblem) {
		color: var(--faint);
	}

	.locked .badge > :global(.badge-corner) {
		opacity: 0.2;
	}

	.feat-title {
		margin: 0;
		font-family: var(--font-carved);
		font-weight: 500;
		font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
		line-height: 1.25;
		letter-spacing: 0.05em;
		color: var(--cream);
		text-shadow: var(--glow-text);
	}

	/* The chosen row's words glow: the one under the cursor, or reached with the arrow keys. */
	.feat-title,
	.feat-org,
	.feat-when,
	.feat-summary {
		transition:
			color 0.3s var(--ease),
			text-shadow 0.3s var(--ease);
	}

	.feat[data-selected] .feat-title {
		color: #fff;
		text-shadow: var(--glow-lit);
	}

	.feat[data-selected] :is(.feat-org, .feat-summary) {
		text-shadow: var(--glow-text);
	}

	.feat[data-selected] .feat-org {
		color: #fff;
	}

	.feat[data-selected] :is(.feat-when, .feat-summary) {
		color: var(--soft);
	}

	.locked .feat-title {
		color: var(--soft);
		text-shadow: none;
	}

	.feat-link {
		text-decoration: none;
	}

	/* The whole row opens the write-up. */
	.feat-link::after {
		content: '';
		position: absolute;
		inset: -0.5rem -0.75rem;
	}

	.feat-link:focus-visible {
		outline: none;
	}

	.feat:has(.feat-link:focus-visible) {
		outline: 1px solid rgba(243, 240, 232, 0.5);
		outline-offset: 0.6rem;
	}

	.feat-org {
		margin: 0.2rem 0 0;
		font-size: 1.1rem;
		color: var(--pale);
	}

	.feat-when {
		color: var(--dim);
		white-space: nowrap;
	}

	/* On a phone the dates take their own line rather than wrap behind a dot. */
	@media (max-width: 640px) {
		.feat-when {
			display: block;
		}

		.feat-sep {
			display: none;
		}
	}

	.feat-summary {
		margin: 0.25rem 0 0;
		font-size: 1.04rem;
		line-height: 1.5;
		color: var(--dim);
		text-wrap: pretty;
	}

	/* The rail: a hairline down the right side, its finial marking your place. */
	.rail {
		--progress: 0;
		position: fixed;
		top: 24vh;
		bottom: 14vh;
		right: clamp(1.5rem, 6vw, 6rem);
		width: 2px;
		border-radius: 2px;
		background: linear-gradient(to bottom, var(--hair), rgba(243, 240, 232, 0.55) 80%, transparent);
		box-shadow: 0 0 6px rgba(255, 255, 255, 0.3);
	}

	.rail-thumb {
		position: absolute;
		left: 50%;
		width: 1.6rem;
		translate: -50% calc(var(--progress) * (62vh - 3.7rem));
		color: var(--pale);
	}

	.rail-thumb > :global(.orn) {
		width: 100%;
		height: auto;
	}

	@media (max-width: 1100px) {
		.rail {
			display: none;
		}
	}
</style>
