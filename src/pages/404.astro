---
import Layout from '../layouts/Layout.astro';
import MenuLink from '../components/game/MenuLink.astro';
---

<Layout title="Not found" noindex back="/">
	<main id="main" class="screen lost">
		<svg class="lost-mark" viewBox="0 0 120 120" aria-hidden="true" data-enter>
			<circle cx="60" cy="60" r="38" />
			<path d="M60 8 66 22H54ZM60 112 54 98H66Z" class="fill" />
			<path d="M60 36 67 60 60 84 53 60Z" class="fill" />
			<circle cx="60" cy="60" r="3.5" class="hole" />
			<path d="M33 33 87 87" />
		</svg>
		<h1 class="lost-title" data-enter style="--delay: 250">This path isn't on the map</h1>
		<p class="lost-text" data-enter style="--delay: 400">The page you were looking for doesn't exist, or has moved.</p>
		<nav aria-label="Ways back" data-enter style="--delay: 550">
			<ul class="menu" data-menu data-keys>
				<li><MenuLink href="/">Return to Menu</MenuLink></li>
			</ul>
		</nav>
	</main>
</Layout>

<style>
	.lost {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		min-height: 100vh;
		min-height: 100dvh;
		padding: 3rem var(--gutter);
		text-align: center;
	}

	.lost-mark {
		width: clamp(6rem, 12vw, 8rem);
		fill: none;
		stroke: var(--pale);
		stroke-width: 4;
		stroke-linecap: round;
		filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.45));
	}

	.lost-mark .fill {
		fill: var(--pale);
		stroke: none;
	}

	.lost-mark .hole {
		fill: var(--void);
		stroke: none;
	}

	.lost-title {
		margin: 0.5rem 0 0;
		font-family: var(--font-book);
		font-weight: 400;
		font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
		line-height: 1.25;
		text-wrap: balance;
		text-shadow: var(--glow-text);
	}

	.lost-text {
		max-width: 30rem;
		margin: 0;
		font-size: 1.15rem;
		color: var(--soft);
	}

	nav {
		margin-top: 1.5rem;
	}
</style>
