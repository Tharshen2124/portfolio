---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getExperience, hasWriteup, type Experience } from '../../lib/experience';
import { formatRange } from '../../lib/format';
import { absoluteUrl, breadcrumbSchema, graph, personId, personSchema } from '../../lib/seo';

export const getStaticPaths = (async () => {
	const entries = await getExperience();
	return entries.filter(hasWriteup).map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

interface Props {
	entry: Experience;
}

const { entry } = Astro.props;
const { title, role, organization, startDate, endDate, location, summary, skills, links } =
	entry.data;
const { Content } = await render(entry);

const meta = [`${role}, ${organization}`, formatRange(startDate, endDate), location].filter(Boolean);

const path = `/experience/${entry.id}`;
const jsonLd = graph(
	{
		'@type': 'Article',
		'@id': `${absoluteUrl(path)}#article`,
		url: absoluteUrl(path),
		mainEntityOfPage: absoluteUrl(path),
		headline: title,
		description: summary,
		datePublished: startDate.toISOString(),
		author: { '@id': personId },
		about: { '@type': 'Organization', name: organization },
		keywords: skills.join(', '),
		inLanguage: 'en',
	},
	personSchema(),
	breadcrumbSchema([
		{ name: 'Home', path: '/' },
		{ name: 'Experience', path: '/experience' },
		{ name: title, path },
	]),
);
---

<Layout
	title={title}
	description={summary}
	type="article"
	publishedTime={startDate}
	markdownUrl={`${path}.md`}
	jsonLd={jsonLd}
>
	<article>
		<h1 class="article-title">{title}</h1>
		<p class="article-meta">{meta.join(' · ')}</p>

		<div class="prose">
			<Content />
		</div>

		<footer class="article-footer">
			{
				skills.length > 0 && (
					<p>
						<span class="muted">Skills:</span> {skills.join(', ')}
					</p>
				)
			}
			{
				links.map(({ label, url }) => (
					<p>
						<a class="more-link" href={url} target="_blank" rel="noopener noreferrer">
							{label} ↗
						</a>
					</p>
				))
			}
			<p>
				<a class="more-link" href="/experience">← back to experience</a>
			</p>
		</footer>
	</article>
</Layout>
