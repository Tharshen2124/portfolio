---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../../layouts/OriginalLayout.astro';
import Prose from '../../../components/original/Prose.astro';
import { getExperience, hasWriteup, writeupSchema, type Experience } from '../../../lib/experience';
import { formatRange } from '../../../lib/format';
import { originalPath } from '../../../lib/original';

export const getStaticPaths = (async () => {
	const entries = await getExperience();
	return entries.filter(hasWriteup).map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

interface Props {
	entry: Experience;
}

const { entry } = Astro.props;
const { title, role, organization, startDate, endDate, location, summary, skills, links } =
	entry.data;
const { Content } = await render(entry);

const meta = [`${role}, ${organization}`, formatRange(startDate, endDate), location].filter(Boolean);

// Same write-up as the main design's page, so that copy is the one search engines index.
const path = `/experience/${entry.id}`;
---

<Layout
	title={title}
	description={summary}
	type="article"
	markdownUrl={`${path}.md`}
	canonicalPath={path}
	jsonLd={writeupSchema(entry)}
>
	<article>
		<h1 class="article-title">{title}</h1>
		<p class="article-meta">{meta.join(' · ')}</p>

		<div class="prose">
			<Prose><Content /></Prose>
		</div>

		<footer class="article-footer">
			{
				skills.length > 0 && (
					<p>
						<span class="muted">Skills:</span> {skills.join(', ')}
					</p>
				)
			}
			{
				links.map(({ label, url }) => (
					<p>
						<a
							class="more-link"
							href={url}
							target="_blank"
							rel="noopener noreferrer"
						>
							{label} ↗
						</a>
					</p>
				))
			}
			<p>
				<a class="more-link" href={originalPath('/experience')}>← back to experience</a>
			</p>
		</footer>
	</article>
</Layout>
