---
import Layout from '../../../layouts/OriginalLayout.astro';
import EntryList from '../../../components/original/EntryList.astro';
import { categories, getExperience, experienceHref } from '../../../lib/experience';
import { formatMonth } from '../../../lib/format';
import { absoluteUrl, breadcrumbSchema, graph, personId, personSchema } from '../../../lib/seo';
import { originalPath } from '../../../lib/original';

const experience = await getExperience();

const sections = categories.map(({ id, label }) => ({
	id,
	label,
	entries: experience
		.filter((entry) => entry.data.category === id)
		.map((entry) => {
			const href = experienceHref(entry);
			return {
				date: formatMonth(entry.data.startDate),
				title: `${entry.data.role}, ${entry.data.organization}`,
				href: href && originalPath(href),
			};
		}),
}));

const description = "Write-ups of Tharshen's work and volunteer experience.";
const writeups = experience.filter((entry) => experienceHref(entry));
const jsonLd = graph(
	{
		'@type': 'CollectionPage',
		url: absoluteUrl(originalPath('/experience')),
		name: 'Experience',
		description,
		author: { '@id': personId },
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: writeups.map((entry, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: entry.data.title,
				url: absoluteUrl(originalPath(experienceHref(entry)!)),
			})),
		},
	},
	personSchema(),
	breadcrumbSchema([
		{ name: 'Home', path: originalPath('/') },
		{ name: 'Experience', path: originalPath('/experience') },
	]),
);
---

<Layout title="Experience" description={description} jsonLd={jsonLd}>
	<h1 class="page-title">Experience</h1>
	<p class="lede">
		Where I've worked, and the societies and events I've volunteered for.
	</p>

	{
		sections.map(({ id, label, entries }) => (
			<section id={id}>
				<h2 class="section-title">{label}</h2>
				<EntryList entries={entries} />
			</section>
		))
	}
</Layout>
