---
/**
 * The main design of the site: every screen dressed as a game's menus, over
 * a misty underground scene. (The original, plain design is OriginalLayout.)
 */
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SiteHead, { type SeoProps } from '../components/SiteHead.astro';
import Scene from '../components/game/Scene.astro';
import Sprite from '../components/game/Sprite.astro';
import Music from '../components/game/Music.astro';
import StartScreen from '../components/game/StartScreen.astro';
import '../styles/game.css';

interface Props extends SeoProps {
	/** The pale title hall, or the darker cavern behind every other screen. */
	scene?: 'title' | 'cavern';
	/** Where Escape leads: the screen this one was opened from. */
	back?: string;
}

const { scene = 'cavern', back, ...seo } = Astro.props;

// The screen is drawn first, so the sprite can carry just the ornaments and
// emblems it refers to rather than the whole set.
const page = await Astro.slots.render('default');
const used = new Set(Array.from(page.matchAll(/href="#((?:orn|emb)-[\w-]+)"/g), (match) => match[1]));
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead {...seo} themeColor="#030406" />
		<Font cssVariable="--font-carved" preload />
		<Font cssVariable="--font-book" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-italic" />
		{/* Screens change without a full page load, so the music plays straight through. */}
		<ClientRouter />
	</head>
	<body data-back={back}>
		{/* First, so it covers the page before any of the site is drawn. */}
		<StartScreen />
		<a class="skip" href="#main">Skip to content</a>
		<Sprite used={used} />
		<Scene variant={scene} />
		<Music />
		<Fragment set:html={page} />
	</body>
</html>

<script>
	import { navigate } from 'astro:transitions/client';

	// Menus work like the game's: hovering or focusing an item selects it, the
	// arrow keys move the selection and Enter follows it. Escape goes back, and
	// the left and right arrows step to the neighbouring screens.
	const linkOf = (item: Element) =>
		(item.matches('a') ? item : item.querySelector('a')) as HTMLAnchorElement | null;

	// A screen's arrow-key menu runs on into the Back link at its foot.
	const itemsOf = (menu: HTMLElement) => [
		...menu.querySelectorAll<HTMLElement>('[data-item]'),
		...(menu.hasAttribute('data-keys') ? document.querySelectorAll<HTMLElement>('.back [data-item]') : []),
	];

	// Each screen is swapped in by the ClientRouter, so its menus are set up on every page load.
	document.addEventListener('astro:page-load', () => {
		for (const menu of document.querySelectorAll<HTMLElement>('[data-menu]')) {
			const items = itemsOf(menu);
			const select = (item: HTMLElement) => {
				if (item.hasAttribute('data-selected')) return;
				for (const other of items) other.toggleAttribute('data-selected', other === item);
				menu.dispatchEvent(new CustomEvent('menuselect', { detail: item }));
			};
			for (const item of items) {
				item.addEventListener('pointerenter', (event) => {
					if (event.pointerType === 'mouse') select(item);
				});
				item.addEventListener('focusin', () => select(item));
			}
			const first = items.find((item) => item.hasAttribute('data-selected')) ?? items[0];
			if (first) {
				first.removeAttribute('data-selected');
				select(first);
			}
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
		const target = event.target as HTMLElement;
		if (target.closest('input, textarea, select, [contenteditable]')) return;

		const menu = target.closest<HTMLElement>('[data-menu]') ?? document.querySelector<HTMLElement>('[data-menu][data-keys]');
		const items = menu ? itemsOf(menu) : [];
		const current = items.findIndex((item) => item.hasAttribute('data-selected'));

		if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && items.length) {
			const step = event.key === 'ArrowDown' ? 1 : -1;
			const next = items[(current + step + items.length) % items.length];
			(linkOf(next) ?? next).focus();
			event.preventDefault();
		} else if (event.key === 'Enter' && target === document.body && current >= 0) {
			linkOf(items[current])?.click();
		} else if (event.key === 'Escape' && document.body.dataset.back) {
			navigate(document.body.dataset.back);
		} else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
			document.querySelector<HTMLAnchorElement>(`[data-key="${event.key}"]`)?.click();
		}
	});
</script>
