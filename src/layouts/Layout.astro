---
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Space from '../components/Space.astro';
import Gate from '../components/Gate.astro';
import PostHog from '../components/posthog.astro';
import { site } from '../data/site';
import { absoluteUrl, defaultImage, pagePath, type JsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article' | 'profile';
	/** Keep the page out of search results (e.g. 404). */
	noindex?: boolean;
	/** Markdown copy of this page, advertised to agents via rel="alternate". */
	markdownUrl?: string;
	jsonLd?: JsonLd;
	/** Skip the reading column so the page can lay itself out edge to edge. */
	fullBleed?: boolean;
}

const {
	title,
	description = site.description,
	type = 'website',
	noindex = false,
	markdownUrl,
	jsonLd,
	fullBleed = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonicalURL = absoluteUrl(pagePath(Astro.url));
const image = await defaultImage();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonicalURL} />
		<meta name="theme-color" content="#05070d" />
		<script is:inline>
			// Apply the reader's chosen mode before first paint: "plain" (the original
			// minimal site), "map" (the star map), or "ask" when they haven't chosen.
			(() => {
				let mode;
				try {
					mode = localStorage.getItem('site-mode');
				} catch {}
				document.documentElement.dataset.mode = mode === 'plain' || mode === 'map' ? mode : 'ask';
				if (mode === 'plain') {
					const dark = matchMedia('(prefers-color-scheme: dark)').matches;
					document.querySelector('meta[name="theme-color"]').content = dark ? '#000000' : '#ffffff';
				}
			})();
		</script>

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={site.title} />
		<meta property="og:locale" content={site.locale} />
		<meta property="og:image" content={image.url} />
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		<meta property="og:image:alt" content={image.alt} />
		{type === 'article' && <meta property="article:author" content={site.url} />}

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image.url} />
		<meta name="twitter:image:alt" content={image.alt} />

		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${site.name} on Substack`}
			href={`${site.substackUrl}/feed`}
		/>
		{markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-display" preload />
		<PostHog />
	</head>
	<body>
		<Space dim={!fullBleed} />
		<Nav />
		<main class={fullBleed ? undefined : 'container'}>
			<slot />
		</main>
		<Footer />
		<Gate />
	</body>
</html>
