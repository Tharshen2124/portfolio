---
import { techIconPath } from '../lib/tech-icons';

interface Props {
	stack: string[];
}

const { stack } = Astro.props;
---

<ul class="stack" aria-label="Tools used">
	{
		stack.map((name) => {
			const path = techIconPath(name);
			return (
				<li>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						{path ? (
							<path d={path} />
						) : (
							// Neutral placeholder for tools Simple Icons doesn't cover.
							<rect x="4" y="4" width="16" height="16" rx="4" />
						)}
					</svg>
					{name}
				</li>
			);
		})
	}
</ul>

<style>
	.stack {
		list-style: none;
		margin: 0.75rem 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: var(--code-bg);
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.4;
	}

	svg {
		flex: 0 0 auto;
		width: 0.95rem;
		height: 0.95rem;
		fill: currentColor;
	}
</style>
