---
/**
 * Back to the screen this one was opened from, as the game's menus end. It's
 * the last item of the screen's menu, so the arrow keys run down to it.
 */
import MenuLink from './MenuLink.astro';

interface Props {
	href: string;
	/** Where it leads, for screen readers and the tooltip. */
	to: string;
}

const { href, to } = Astro.props;
---

<nav class="back" aria-label="Back">
	<MenuLink href={href} title={`Back to ${to}`}>
		Back<span class="visually-hidden"> to {to}</span>
	</MenuLink>
</nav>
