---
/** A screen's title in carved capitals, over its inked rule. */
import Ornament from './Ornament.astro';
---

<header class="screen-head" data-enter>
	<h1 class="screen-title"><slot /></h1>
	<div class="rule"><Ornament name="divider" /></div>
</header>

<style>
	.screen-head {
		padding-inline: var(--gutter);
	}
</style>
