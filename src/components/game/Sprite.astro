---
/**
 * Each ornament (and, where asked, each emblem) defined once per page, so the
 * many pointers and frames on a screen reuse one drawing.
 */
import { ornaments } from '../../lib/ornaments';
import { emblems } from '../../lib/emblems';

interface Props {
	/** Also define the emblems, for screens with medallions and badges. */
	withEmblems?: boolean;
}

const { withEmblems = false } = Astro.props;
---

<svg width="0" height="0" class="sprite" aria-hidden="true" focusable="false">
	{
		Object.entries(ornaments).map(([name, { width, height, d }]) => (
			<symbol id={`orn-${name}`} viewBox={`0 0 ${width} ${height}`}>
				<path d={d} />
			</symbol>
		))
	}
	{
		withEmblems &&
			Object.entries(emblems).map(([name, d]) => (
				<symbol id={`emb-${name}`} viewBox="0 0 48 48">
					<path d={d} />
				</symbol>
			))
	}
</svg>

<style>
	.sprite {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}
</style>
