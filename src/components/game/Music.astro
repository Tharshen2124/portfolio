---
/**
 * Background music for the game design, with its toggle at the top of every
 * screen. It starts as soon as the browser allows, loops, and remembers being
 * switched off (localStorage).
 *
 * The audio element and its toggle are kept across page changes by the
 * ClientRouter, so the music plays straight through them. The original design
 * has no router, so going there is a full page load and the music stops; the
 * track position is saved (sessionStorage) and picked up again on return.
 *
 * Browsers only allow sound after a click or key press on the site, so on a
 * fresh visit the music starts with the visitor's first click or key press,
 * and the toggle pulses until then.
 */
---

<button type="button" class="music" aria-pressed="true" title="Music" transition:persist="music-toggle">
	<span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
	<span class="music-label">Music</span>
</button>
<audio class="soundtrack" src="/audio/medieval-background.m4a" loop preload="none" transition:persist="soundtrack"></audio>

<script>
	const PREF = 'game-music';
	const POSITION = 'game-music-position';
	const VOLUME = 0.2;

	const audio = document.querySelector<HTMLAudioElement>('audio.soundtrack')!;
	const toggle = document.querySelector<HTMLButtonElement>('button.music')!;

	const read = (store: () => Storage, key: string) => {
		try {
			return store().getItem(key);
		} catch {
			return null;
		}
	};
	const write = (store: () => Storage, key: string, value: string) => {
		try {
			store().setItem(key, value);
		} catch {
			// Private browsing: nothing is remembered.
		}
	};

	const enabled = () => read(() => localStorage, PREF) !== 'off';
	const wanted = () => enabled() && !document.hidden;

	const show = () => {
		const waiting = wanted() && audio.paused;
		toggle.setAttribute('aria-pressed', String(enabled()));
		toggle.classList.toggle('playing', !audio.paused);
		toggle.classList.toggle('waiting', waiting);
		toggle.title = waiting ? 'Music: click anywhere to start' : 'Music';
	};

	let fade = 0;
	const fadeTo = (target: number, seconds: number, done?: () => void) => {
		cancelAnimationFrame(fade);
		const from = audio.volume;
		const start = performance.now();
		const step = (now: number) => {
			// A frame's timestamp can come just before `start`, so keep t within 0 to 1.
			const t = Math.min(Math.max((now - start) / (seconds * 1000), 0), 1);
			audio.volume = from + (target - from) * t;
			if (t < 1) fade = requestAnimationFrame(step);
			else done?.();
		};
		fade = requestAnimationFrame(step);
	};

	let restored = false;
	const play = () => {
		if (!wanted() || !audio.paused) return;
		if (!restored) {
			restored = true;
			const at = Number(read(() => sessionStorage, POSITION));
			if (at > 0) audio.currentTime = at;
		}
		audio.volume = 0;
		audio
			.play()
			.then(() => fadeTo(VOLUME, 2))
			.catch(() => {
				// Blocked until the visitor clicks or presses a key.
			});
	};

	const stop = () => {
		if (!audio.paused) fadeTo(0, 0.6, () => audio.pause());
	};

	const sync = () => {
		if (wanted()) play();
		else stop();
		show();
	};

	// Each click or key press starts the music if it's on but not playing: the
	// browser's first allowed moment, or after something else paused it. Browsers
	// differ in which events count (Safari wants a click or key press). Presses on
	// the toggle are left to the toggle, so they don't start the music they mean to stop.
	const resume = (event: Event) => {
		if (!toggle.contains(event.target as Node)) play();
	};
	for (const type of ['pointerdown', 'pointerup', 'mousedown', 'click', 'touchend', 'keydown']) {
		document.addEventListener(type, resume, { capture: true, passive: true });
	}

	audio.addEventListener('play', show);
	audio.addEventListener('pause', show);

	toggle.addEventListener('click', () => {
		const on = !enabled();
		write(() => localStorage, PREF, on ? 'on' : 'off');
		sync();
		(window as { posthog?: { capture: (event: string, props: object) => void } }).posthog?.capture('music_toggled', { on });
	});

	// Quiet while the tab is in the background, and picked up again when Back
	// brings a screen out of the browser's cache.
	document.addEventListener('visibilitychange', sync);
	window.addEventListener('pageshow', (event) => {
		if (event.persisted) sync();
	});
	window.addEventListener('pagehide', () => write(() => sessionStorage, POSITION, String(audio.currentTime)));

	sync();
</script>

<style>
	.music {
		position: absolute;
		top: clamp(0.75rem, 2.2vw, 1.6rem);
		left: 50%;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 44px;
		padding: 0 0.4rem;
		border: 0;
		background: none;
		color: var(--soft);
		font-family: var(--font-carved);
		font-weight: 500;
		font-size: clamp(0.85rem, 0.8rem + 0.25vw, 1rem);
		letter-spacing: 0.1em;
		cursor: pointer;
		translate: -50% 0;
		transition:
			color 0.2s,
			text-shadow 0.2s;
	}

	.music:hover,
	.music:focus-visible {
		color: #fff;
		text-shadow: var(--glow-lit);
	}

	.music[aria-pressed='true'] {
		color: var(--pale);
	}

	.bars {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		height: 0.85rem;
		filter: var(--glow-ink);
	}

	.bars i {
		width: 2px;
		height: 20%;
		border-radius: 1px;
		background: currentColor;
		transition: height 0.3s;
	}

	.music[aria-pressed='true'] .bars i {
		height: 55%;
	}

	.music.playing .bars i {
		animation: level 1.1s ease-in-out infinite alternate;
	}

	.music.playing .bars i:nth-child(2) {
		animation-duration: 0.8s;
		animation-delay: -0.3s;
	}

	.music.playing .bars i:nth-child(3) {
		animation-duration: 1.3s;
		animation-delay: -0.6s;
	}

	.music.playing .bars i:nth-child(4) {
		animation-duration: 0.95s;
		animation-delay: -0.2s;
	}

	@keyframes level {
		from {
			height: 20%;
		}

		to {
			height: 100%;
		}
	}

	/* On, but the browser is holding the music until the first click or key. */
	.music.waiting .bars {
		animation: waiting 1.6s ease-in-out infinite;
	}

	@keyframes waiting {
		50% {
			opacity: 0.3;
		}
	}

	.music[aria-pressed='false'] .music-label {
		text-decoration: line-through;
		text-decoration-thickness: 1px;
	}

	@media (prefers-reduced-motion: reduce) {
		.music.playing .bars i,
		.music.waiting .bars {
			animation: none;
		}
	}
</style>
