---
/**
 * Background music for the star map. Plays only in "map" mode, loops, and
 * remembers whether the reader turned it off (localStorage).
 *
 * The audio element and its toggle are persisted by the ClientRouter, so the
 * music plays straight through page changes. A full reload does start a new
 * document, so the track position is saved (sessionStorage) and picked up again.
 *
 * Browsers only start sound after a click or key press. Choosing "explore" on
 * the title screen is that press. After a reload the browser blocks playback,
 * so the music resumes on the reader's first click or key press instead, and
 * the toggle pulses until then.
 */
---

<button type="button" class="sound" aria-pressed="true" title="Music" transition:persist="sound-toggle">
	<span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
	<span class="label">Music</span>
</button>
<audio
	class="soundtrack"
	src="/audio/ethereal-strings.m4a"
	loop
	preload="none"
	transition:persist="soundtrack"
></audio>

<script>
	const PREF = 'site-sound';
	const POSITION = 'site-sound-position';
	const VOLUME = 0.16;

	const root = document.documentElement;
	const audio = document.querySelector<HTMLAudioElement>('audio.soundtrack')!;
	const toggle = document.querySelector<HTMLButtonElement>('button.sound')!;

	const read = (store: Storage, key: string) => {
		try {
			return store.getItem(key);
		} catch {
			return null;
		}
	};
	const write = (store: Storage, key: string, value: string) => {
		try {
			store.setItem(key, value);
		} catch {
			// Private browsing: nothing is remembered.
		}
	};

	const enabled = () => read(localStorage, PREF) !== 'off';
	const wanted = () => root.dataset.mode === 'map' && enabled() && !document.hidden;

	const show = () => {
		const waiting = wanted() && audio.paused;
		toggle.setAttribute('aria-pressed', String(enabled()));
		toggle.classList.toggle('playing', !audio.paused);
		toggle.classList.toggle('waiting', waiting);
		toggle.title = waiting ? 'Music: click anywhere to start' : 'Music';
	};

	let fade = 0;
	const fadeTo = (target: number, done?: () => void) => {
		cancelAnimationFrame(fade);
		const from = audio.volume;
		const start = performance.now();
		const step = (now: number) => {
			const t = Math.min((now - start) / 1200, 1);
			audio.volume = from + (target - from) * t;
			if (t < 1) fade = requestAnimationFrame(step);
			else done?.();
		};
		fade = requestAnimationFrame(step);
	};

	let restored = false;
	const play = () => {
		if (!wanted() || !audio.paused) return;
		if (!restored) {
			restored = true;
			const at = Number(read(sessionStorage, POSITION));
			if (at > 0) audio.currentTime = at;
		}
		audio.volume = 0;
		audio
			.play()
			.then(() => fadeTo(VOLUME))
			.catch(() => {
				// Blocked until the reader interacts with the page.
			});
	};

	const stop = () => {
		if (audio.paused) return;
		fadeTo(0, () => audio.pause());
	};

	const sync = () => {
		if (wanted()) play();
		else stop();
		show();
	};

	// Retry on interactions until playback is allowed. Presses on the toggle
	// are left to the toggle, so they don't start the music they mean to stop.
	const unlock = (event: Event) => {
		if (toggle.contains(event.target as Node)) return;
		play();
	};
	for (const type of ['pointerdown', 'pointerup', 'touchend', 'keydown']) {
		document.addEventListener(type, unlock, { capture: true, passive: true });
	}
	audio.addEventListener('playing', () => {
		for (const type of ['pointerdown', 'pointerup', 'touchend', 'keydown']) {
			document.removeEventListener(type, unlock, { capture: true });
		}
	});

	audio.addEventListener('play', show);
	audio.addEventListener('pause', show);

	toggle.addEventListener('click', () => {
		const on = !enabled();
		write(localStorage, PREF, on ? 'on' : 'off');
		show();
		sync();
		(window as { posthog?: { capture: (event: string, props: object) => void } }).posthog?.capture(
			'music_toggled',
			{ on },
		);
	});

	window.addEventListener('sitemode', sync);
	document.addEventListener('visibilitychange', sync);
	window.addEventListener('pagehide', () => {
		write(sessionStorage, POSITION, String(audio.currentTime));
	});

	show();
	sync();
</script>

<style>
	.sound {
		display: none;
		align-items: center;
		gap: 0.55rem;
		padding: 0.4rem 0.1rem;
		border: 0;
		background: none;
		color: var(--muted);
		font: inherit;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		cursor: pointer;
		transition: color 0.15s;
	}

	:global(html[data-mode='map']) .sound {
		display: inline-flex;
	}

	.sound:hover,
	.sound[aria-pressed='true'] {
		color: var(--fg-strong);
	}

	.bars {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		height: 0.8rem;
	}

	.bars i {
		width: 2px;
		height: 20%;
		background: currentColor;
		transition: height 0.3s;
	}

	.sound[aria-pressed='true'] .bars i {
		height: 55%;
	}

	.sound.playing .bars i {
		animation: level 1.1s ease-in-out infinite alternate;
	}

	.sound.playing .bars i:nth-child(2) {
		animation-duration: 0.8s;
		animation-delay: -0.3s;
	}

	.sound.playing .bars i:nth-child(3) {
		animation-duration: 1.3s;
		animation-delay: -0.6s;
	}

	.sound.playing .bars i:nth-child(4) {
		animation-duration: 0.95s;
		animation-delay: -0.2s;
	}

	@keyframes level {
		from {
			height: 20%;
		}
		to {
			height: 100%;
		}
	}

	/* On, but the browser is holding playback until the first click or key. */
	.sound.waiting .bars {
		animation: waiting 1.6s ease-in-out infinite;
	}

	@keyframes waiting {
		50% {
			opacity: 0.3;
		}
	}

	.sound[aria-pressed='false'] .label {
		text-decoration: line-through;
		text-decoration-thickness: 1px;
	}

	@media (max-width: 719px) {
		.sound {
			position: absolute;
			top: 0.9rem;
			right: clamp(1.25rem, 4vw, 4.5rem);
		}
	}
</style>
