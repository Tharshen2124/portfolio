---
import { site } from '../data/site';

const links = [
	{ href: site.links.github, label: 'github' },
	{ href: site.links.linkedin, label: 'linkedin' },
	{ href: site.links.substack, label: 'substack' },
];
---

<footer>
	<ul>
		{
			links.map(({ href, label }) => (
				<li>
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						data-posthog-social-profile={label}
					>
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
							<path
								d="M2.07102 11.3494L0.963068 10.2415L9.2017 1.98864H2.83807L2.85227 0.454545H11.8438V9.46023H10.2955L10.3097 3.09659L2.07102 11.3494Z"
								fill="currentColor"
							/>
						</svg>
						<span>{label}</span>
					</a>
				</li>
			))
		}
	</ul>
	<p>© {new Date().getFullYear()} {site.name}</p>
</footer>

<script is:inline>
	document.querySelectorAll('[data-posthog-social-profile]').forEach((link) => {
		link.addEventListener('click', () => {
			window.posthog?.capture('social_profile_opened', {
				profile: link.dataset.posthogSocialProfile,
			});
		});
	});
</script>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		margin-top: 5rem;
		padding: 1.5rem clamp(1.25rem, 4vw, 4.5rem) 2.25rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
		order: 2;
	}

	a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--fg);
		text-decoration: none;
		text-transform: capitalize;
		transition: color 0.15s;
	}

	a:hover {
		color: var(--accent);
	}

	svg {
		width: 0.6rem;
		height: 0.6rem;
		opacity: 0.6;
	}

	p {
		margin: 0;
	}
</style>
