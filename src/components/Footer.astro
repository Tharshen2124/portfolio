---
import { site } from '../data/site';

const links = [
	{ href: site.links.github, label: 'github' },
	{ href: site.links.linkedin, label: 'linkedin' },
	{ href: site.links.substack, label: 'substack' },
];
---

<footer>
	<ul>
		{
			links.map(({ href, label }) => (
				<li>
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						data-posthog-social-profile={label}
					>
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
							<path
								d="M2.07102 11.3494L0.963068 10.2415L9.2017 1.98864H2.83807L2.85227 0.454545H11.8438V9.46023H10.2955L10.3097 3.09659L2.07102 11.3494Z"
								fill="currentColor"
							/>
						</svg>
						<span>{label}</span>
					</a>
				</li>
			))
		}
	</ul>
	<p class="copyright">
		© {new Date().getFullYear()} {site.name}
		<button type="button" class="switch to-plain" data-set-mode="plain">Switch to the plain site</button>
		<button type="button" class="switch to-map" data-set-mode="map">Explore my destiny →</button>
	</p>
</footer>

<script is:inline>
	document.querySelectorAll('[data-posthog-social-profile]').forEach((link) => {
		link.addEventListener('click', () => {
			window.posthog?.capture('social_profile_opened', {
				profile: link.dataset.posthogSocialProfile,
			});
		});
	});
</script>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		margin-top: 5rem;
		padding: 1.5rem clamp(1.25rem, 4vw, 4.5rem) 2.25rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
		order: 2;
	}

	a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--fg);
		text-decoration: none;
		text-transform: capitalize;
		transition: color 0.15s;
	}

	a:hover {
		color: var(--accent);
	}

	svg {
		width: 0.6rem;
		height: 0.6rem;
		opacity: 0.6;
	}

	p {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.5rem;
		margin: 0;
	}

	/* Mode switch: only the one that leads away from the current mode is shown. */
	.switch {
		padding: 0;
		border: 0;
		background: none;
		color: var(--fg);
		font: inherit;
		letter-spacing: inherit;
		text-decoration: underline;
		text-decoration-color: var(--subtle);
		text-underline-offset: 3px;
		cursor: pointer;
		transition: color 0.15s;
	}

	.switch:hover {
		color: var(--accent);
	}

	.to-map {
		display: none;
	}

	/* Plain mode: the original stacked footer. */
	:global(html[data-mode='plain']) footer {
		display: block;
		margin: 4rem 0;
		padding: 0;
		border: 0;
		font-size: inherit;
		letter-spacing: normal;
	}

	:global(html[data-mode='plain']) ul {
		gap: 0.5rem 1rem;
	}

	:global(html[data-mode='plain']) a {
		color: inherit;
		text-transform: none;
	}

	:global(html[data-mode='plain']) a:hover,
	:global(html[data-mode='plain']) .switch:hover {
		color: var(--fg-strong);
	}

	:global(html[data-mode='plain']) svg {
		width: 12px;
		height: 12px;
		opacity: 1;
	}

	:global(html[data-mode='plain']) p {
		margin-top: 2rem;
	}

	:global(html[data-mode='plain']) .switch {
		color: inherit;
	}

	:global(html[data-mode='plain']) .to-plain {
		display: none;
	}

	:global(html[data-mode='plain']) .to-map {
		display: inline;
	}
</style>
