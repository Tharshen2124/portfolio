---
export interface Entry {
	date: string;
	title: string;
	href?: string;
}

interface Props {
	entries: Entry[];
	trackBlogLinks?: boolean;
}

const { entries, trackBlogLinks = false } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<ul class="entries">
	{
		entries.map(({ date, title, href }) => (
			<li>
				<span class="date">{date}</span>
				{href ? (
					<a
						class="title"
						href={href}
						{...(isExternal(href) && { target: '_blank', rel: 'noopener noreferrer' })}
						{...(trackBlogLinks && { 'data-posthog-blog-post': true })}
					>
						{title}
					</a>
				) : (
					<span class="title plain">{title}</span>
				)}
			</li>
		))
	}
</ul>

<style>
	/* Date column sizes to the widest date in the list, like the design. */
	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: max-content 1fr;
		column-gap: 1.5rem;
	}

	li {
		display: grid;
		grid-template-columns: subgrid;
		grid-column: span 2;
		align-items: baseline;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--line);
	}

	.date {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
	}

	.title {
		color: var(--fg-strong);
		text-decoration: none;
	}

	a.title {
		transition: color 0.15s;
	}

	a.title:hover {
		color: var(--accent);
	}

	.title.plain {
		color: var(--fg);
	}

	@media (max-width: 639px) {
		.entries {
			grid-template-columns: 1fr;
		}

		li {
			grid-template-columns: 1fr;
			grid-column: auto;
			row-gap: 0.125rem;
		}
	}

	/* Plain mode: the original loose list. */
	:global(html[data-mode='plain']) .entries {
		column-gap: 1rem;
		row-gap: 1rem;
	}

	:global(html[data-mode='plain']) li {
		padding: 0;
		border: 0;
	}

	:global(html[data-mode='plain']) .date {
		font-size: inherit;
		font-weight: inherit;
		letter-spacing: normal;
		text-transform: none;
	}

	:global(html[data-mode='plain']) a.title:hover {
		color: var(--fg-strong);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 639px) {
		:global(html[data-mode='plain']) li {
			row-gap: 0.125rem;
		}
	}
</style>
