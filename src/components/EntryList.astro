---
export interface Entry {
	date: string;
	title: string;
	href?: string;
}

interface Props {
	entries: Entry[];
	trackBlogLinks?: boolean;
}

const { entries, trackBlogLinks = false } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<ul class="entries">
	{
		entries.map(({ date, title, href }) => (
			<li>
				<span class="date">{date}</span>
				{href ? (
					<a
						class="title"
						href={href}
						{...(isExternal(href) && { target: '_blank', rel: 'noopener noreferrer' })}
						{...(trackBlogLinks && { 'data-posthog-blog-post': true })}
					>
						{title}
					</a>
				) : (
					<span class="title plain">{title}</span>
				)}
			</li>
		))
	}
</ul>

<script is:inline>
	document.querySelectorAll('[data-posthog-blog-post]').forEach((link) => {
		link.addEventListener('click', () => {
			window.posthog?.capture('blog_opened', {
				link_location: 'post_list',
			});
		});
	});
</script>

<style>
	/* Date column sizes to the widest date in the list, like the design. */
	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: max-content 1fr;
		column-gap: 1.5rem;
	}

	li {
		display: grid;
		grid-template-columns: subgrid;
		grid-column: span 2;
		align-items: baseline;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--line);
	}

	.date {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
	}

	.title {
		color: var(--fg-strong);
		text-decoration: none;
	}

	a.title {
		transition: color 0.15s;
	}

	a.title:hover {
		color: var(--accent);
	}

	.title.plain {
		color: var(--fg);
	}

	@media (max-width: 639px) {
		.entries {
			grid-template-columns: 1fr;
		}

		li {
			grid-template-columns: 1fr;
			grid-column: auto;
			row-gap: 0.125rem;
		}
	}
</style>
