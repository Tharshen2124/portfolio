---
/**
 * Fixed backdrop behind every page: nebula glow, a starfield and the map's
 * frame lines. Stars are placed at build time from a seeded generator so the
 * sky is identical on every build and needs no client-side script.
 */
function mulberry32(seed: number) {
	return () => {
		seed |= 0;
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

interface Props {
	/** Quieter sky for pages where text sits directly on it. */
	dim?: boolean;
}

const { dim = false } = Astro.props;

const random = mulberry32(2124);
const tints = ['#ffffff', '#ffffff', '#cfe0ff', '#ffe9c4'];
const stars = Array.from({ length: 320 }, () => {
	const bright = random() > 0.9;
	return {
		x: (random() * 1600).toFixed(1),
		y: (random() * 900).toFixed(1),
		r: (bright ? 0.9 + random() * 0.7 : 0.3 + random() * 0.5).toFixed(2),
		opacity: (bright ? 0.7 + random() * 0.3 : 0.15 + random() * 0.45).toFixed(2),
		fill: tints[Math.floor(random() * tints.length)],
		twinkle: bright && random() > 0.4,
		delay: (random() * 6).toFixed(1),
	};
});
---

<div class:list={['space', { dim }]} aria-hidden="true">
	<div class="nebula"></div>
	<svg class="stars" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
		{
			stars.map(({ x, y, r, opacity, fill, twinkle, delay }) => (
				<circle
					cx={x}
					cy={y}
					r={r}
					fill={fill}
					opacity={opacity}
					class={twinkle ? 'twinkle' : undefined}
					style={twinkle ? `animation-delay:-${delay}s` : undefined}
				/>
			))
		}
	</svg>
	<div class="frame"></div>
</div>

<style>
	.space {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		background: var(--bg);
	}

	.nebula {
		position: absolute;
		inset: -10%;
		background:
			radial-gradient(38% 46% at 50% 4%, rgba(214, 178, 104, 0.3), transparent 70%),
			radial-gradient(30% 34% at 34% 20%, rgba(150, 52, 60, 0.26), transparent 70%),
			radial-gradient(42% 50% at 22% 52%, rgba(40, 78, 160, 0.3), transparent 72%),
			radial-gradient(34% 40% at 74% 34%, rgba(92, 70, 160, 0.24), transparent 70%),
			radial-gradient(40% 40% at 88% 70%, rgba(24, 96, 110, 0.2), transparent 70%),
			radial-gradient(60% 50% at 50% 62%, rgba(120, 130, 170, 0.12), transparent 70%);
	}

	.dim .nebula,
	.dim .stars {
		opacity: 0.55;
	}

	.stars {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.twinkle {
		animation: twinkle 5s ease-in-out infinite;
	}

	@keyframes twinkle {
		50% {
			opacity: 0.15;
		}
	}

	/* Inset frame and centre cross, as if the sky were a chart. */
	.frame {
		position: absolute;
		inset: 1.25rem;
		border: 1px solid var(--line);
		background:
			linear-gradient(var(--line), var(--line)) 50% 0 / 1px 100% no-repeat,
			linear-gradient(var(--line), var(--line)) 0 50% / 100% 1px no-repeat;
		opacity: 0.7;
	}

	/* Edge vignette keeps the HUD text readable over the nebula. */
	.space::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(2, 3, 8, 0.75));
	}

	@media (max-width: 719px) {
		.frame {
			inset: 0.5rem;
		}
	}
</style>
