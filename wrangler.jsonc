{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tharshen-portfolio",
	"compatibility_date": "2026-09-25",
	// Static site: no Worker script, just the Astro build output.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"routes": [
		{
			"pattern": "tharshen.xyz",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
